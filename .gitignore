# Whitelist Winter Arc repository contents from Desktop root
/*
!/.gitignore
!/.eslintrc.js
!/.prettierrc.json
!/.prettierignore
!/package.json
!/pnpm-lock.yaml
!/pnpm-workspace.yaml
!/tsconfig.base.json
!/firebase.json
!/.firebaserc
!/firestore.rules.template
!/firestore.indexes.json
!/README.md
!/AGENTS.md
!/GEMINI.md
!/docs/
!/apps/
!/packages/
!/scripts/
!/tests/
!/.github/

# Ignore build artifacts and generated files within Winter Arc
node_modules/
.pnpm-store/
dist/
build/
*.tsbuildinfo
.next/
out/
.env
.env*.local
.env.development.local
.env.test.local
.env.production.local
!*.example
serviceAccountKey.json
*.pem
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
coverage/
test-results/
playwright-report/
.DS_Store
Thumbs.db
*.swp
*.swo
firestore.rules
