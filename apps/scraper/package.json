{
  "name": "@winter-arc/scraper",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "build": "tsc",
    "scrape": "pnpm build && node dist/cli.js run",
    "scrape:dry": "pnpm build && node dist/cli.js dry-run",
    "scrape:discover": "pnpm build && node dist/cli.js discover",
    "scrape:test": "pnpm build && node dist/cli.js test-source"
  },
  "dependencies": {
    "@winter-arc/shared": "workspace:*",
    "cheerio": "^1.0.0",
    "firebase-admin": "^12.5.0",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
