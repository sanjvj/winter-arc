{
  "manifest_version": 3,
  "name": "Winter Arc Autofill Companion",
  "version": "1.0.0",
  "description": "1-Click autofill for job applications across LinkedIn, Wellfound, Greenhouse, Lever, Ashby, Workday, and company career portals.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Winter Arc Autofill",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "autofill-page": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Autofill current application form"
    }
  }
}
